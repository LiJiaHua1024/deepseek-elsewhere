{
  "name": "elsewhere",
  "version": "0.6.2",
  "description": "去别的地方玩，不要耽误 AGI 训练。纯粹、顺手的 AI 聊天客户端。",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "rspack build -c rspack.config.ts",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "test": "node --experimental-transform-types --import ./tests/ts-loader.mjs --test tests/*.test.ts"
  },
  "dependencies": {
    "@formatjs/intl-displaynames": "8.0.3",
    "@formatjs/intl-locale": "5.4.3",
    "@juggle/resize-observer": "3.4.0",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "abortcontroller-polyfill": "1.7.8",
    "clsx": "2.1.1",
    "core-js": "3.51.0",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "saxes": "6.0.0",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  }
}
